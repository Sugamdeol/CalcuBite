    ]
  },
  "insights": [
    {
      "category": string,
      "details": string,
      "recommendation": string,
      "evidence": string
    }
  ],
  "healthImplications": {
    "shortTerm": [string],
    "longTerm": [string]
  },
  "alternatives": [
    {
      "name": string,
      "benefits": string,
      "preparation": string
    }
  ],
  "nutritionEstimate": {
    "calories": string,
    "protein": string,
    "carbs": string,
    "fat": string,
    "fiber": string,
    "vitamins": [string],
    "minerals": [string],
    "macroRatio": {
      "protein": number,
      "carbs": number,
