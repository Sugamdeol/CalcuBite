    "concerning": [
      {
        "name": string,
        "risk": "high" | "medium" | "low",
        "impact": string,
        "whyAvoid": string,
        "scientificEvidence": string
      }
    ],
    "beneficial": [
      {
        "name": string,
        "benefits": string,
        "nutrientsProvided": [string]
